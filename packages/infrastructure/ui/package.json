{
  "name": "@goto/infrastructure-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vue controls and styles for the goto-vue workspace.",
  "files": [
    "dist",
    "src/scss"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles.scss": {
      "sass": "./src/scss/_index.scss"
    }
  },
  "scripts": {
    "build": "vp build && vp run declarations",
    "dev": "pnpm run \"/^watch:/\"",
    "watch:runtime": "vp build --watch --no-emptyOutDir",
    "watch:types": "vp run declarations --watch",
    "test": "vp test",
    "check": "vp check && vp run vue:typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.46"
  }
}
