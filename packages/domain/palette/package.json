{
  "name": "@goto/domain-palette",
  "version": "0.0.0",
  "private": true,
  "description": "Palette selection and its Vue viewer for the goto-vue workspace.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vp build && vp run declarations",
    "dev": "pnpm run \"/^watch:/\"",
    "watch:runtime": "vp build --watch --no-emptyOutDir",
    "watch:types": "vp run declarations --watch",
    "test": "vp run unit",
    "check": "vp check && vp run vue:typecheck"
  },
  "dependencies": {
    "@goto/infrastructure-http-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.46"
  }
}
