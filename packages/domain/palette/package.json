{
  "name": "@goto/domain-palette",
  "version": "0.0.0",
  "private": true,
  "description": "Palette selection and its Vue viewer for the goto-vue workspace.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./moq": {
      "types": "./dist/index.moq.d.ts",
      "import": "./dist/index.moq.js"
    },
    "./moq/fixtures": {
      "types": "./dist/api/palettes/__tests__/paletteColors.moq.d.ts",
      "import": "./dist/api/palettes/__tests__/paletteColors.moq.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vp build && vp run declarations",
    "dev": "pnpm run \"/^watch:/\"",
    "watch:runtime": "vp build --watch --no-emptyOutDir",
    "watch:types": "vp run declarations --watch",
    "test": "vp run unit",
    "check": "vp check && vp run vue:typecheck"
  },
  "dependencies": {
    "@goto/infrastructure-http-client": "workspace:*",
    "@goto/infrastructure-ui": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "msw": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "msw": "^3.0.8",
    "vue": "^3.5.46"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
