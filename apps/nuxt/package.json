{
  "name": "@goto/nuxt-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run build:dependencies && nuxt build",
    "build:dependencies": "vp run --filter \"@goto/nuxt-app^...\" --concurrency-limit 1 build",
    "dev": "vp run build:dependencies && vp run --no-cache dev:server",
    "dev:server": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "vue:typecheck": "vp run build:dependencies && nuxt prepare && node ../../tooling/vue-tsc.cjs -b --noEmit"
  },
  "dependencies": {
    "@goto/domain-palette": "workspace:*",
    "@goto/domain-palette-ssr": "workspace:*",
    "nuxt": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "msw": "catalog:"
  }
}
