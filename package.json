{
  "name": "goto-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ready": "vp run -r build && vp run check && vp run -r test",
    "dev": "vp run website#dev",
    "check": "vp run -r vue:typecheck && vp check"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-angular": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  }
}
